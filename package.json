{
  "name": "study-flow-organizer",
  "version": "4.3.0",
  "description": "Smart Academic Schedule, Folders Hub & Task Organizer",
  "main": "server/server.js",
  "scripts": {
    "start": "node desktop/launcher.js",
    "server": "node server/server.js",
    "build:exe": "node scripts/build_standalone_exe.js",
    "build:launcher": "gcc -mwindows -O2 scripts/launcher.c -o Study_Flow_Organizer.exe -lws2_32",
    "test": "vitest run",
    "check": "tsc -p jsconfig.json",
    "test:watch": "vitest"
  },
  "keywords": [
    "academic",
    "organizer",
    "planner",
    "kanban",
    "timeline",
    "shamsi",
    "jalali",
    "ai-assistant",
    "voice-notes",
    "desktop-app"
  ],
  "author": "Amirali Navidi & Sina Sharifi",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}