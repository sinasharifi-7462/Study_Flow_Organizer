{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/tooling/cli/schema.json",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "devPath": "http://127.0.0.1:3456",
    "distDir": "../app"
  },
  "package": {
    "productName": "Study Flow Organizer",
    "version": "4.2.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "fs": {
        "all": true,
        "scope": ["$APPDATA/StudyFlowOrganizer/**"]
      },
      "dialog": {
        "all": true,
        "open": true
      },
      "shell": {
        "all": false,
        "open": true
      },
      "path": {
        "all": true
      }
    },
    "bundle": {
      "active": true,
      "category": "Education",
      "copyright": "MIT License",
      "identifier": "com.studyflow.organizer",
      "targets": ["msi", "nsis"]
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "fullscreen": false,
        "height": 840,
        "resizable": true,
        "title": "Study Flow Organizer",
        "width": 1320,
        "minWidth": 880,
        "minHeight": 620,
        "center": true
      }
    ]
  }
}
